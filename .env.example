# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# TELEGRAM_BOT_TOKEN: Telegram Bot Token obtained from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ).
# Configure this in AI Studio Settings (Secrets panel) so the bot connects automatically without needing to re-enter it.
TELEGRAM_BOT_TOKEN=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ENABLE_TELEGRAM_POLLING: Set to true by default. Set to false if you want this instance to act as a UI/management node only while Render handles polling.
ENABLE_TELEGRAM_POLLING=true

# Performance Optimization & MTProto Tuning
# TELEGRAM_API_ID & TELEGRAM_API_HASH: Optional custom app credentials from https://my.telegram.org
# When provided, the app uses your dedicated Telegram MTProto application keys.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# MTProto parallel worker concurrency limits
MTPROTO_DOWNLOAD_WORKERS=3
MTPROTO_UPLOAD_WORKERS=8
DOWNLOAD_SEMAPHORE_LIMIT=4
FFMPEG_SEMAPHORE_LIMIT=3
